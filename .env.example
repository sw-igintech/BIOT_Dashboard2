# Supabase secrets — set server-side only, never committed to git.
# Only BIOT_BASE_URL is required at runtime.
#
# Run:  supabase secrets set BIOT_BASE_URL=<your-biot-base-url>

BIOT_BASE_URL=<your-biot-base-url>

# BIOT_USERNAME and BIOT_PASSWORD are NOT used by the current Edge Function.
# The dashboard uses per-user BIOT login; no shared service account credentials
# are needed at runtime. These keys are listed here for historical reference only.
# BIOT_USERNAME=your-biot-username
# BIOT_PASSWORD=your-biot-password
